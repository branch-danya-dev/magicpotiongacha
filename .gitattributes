# The inspected package receipt hashes exact bytes on Windows and Ubuntu.
assets/environment/megakit/** -text whitespace=cr-at-eol
assets/environment/atmosphere/** -text whitespace=cr-at-eol
assets/environment/polish/** -text whitespace=cr-at-eol
assets/environment/fantasy/** -text whitespace=cr-at-eol
assets/environment/stability-sky/** -text whitespace=cr-at-eol
assets/environment/woodland/** -text whitespace=cr-at-eol
assets/props/*.rbxmx -text whitespace=cr-at-eol
# AG-67 original art and capture receipts are hashed byte-for-byte on both CI hosts.
assets/vfx/ag67/** -text
assets/vfx/ag67b/** -text
docs/evidence/ag67b/** -text
docs/evidence/ag67/** -text
qa/ag67/** text eol=lf
docs/evidence/ag01/*.log -text whitespace=cr-at-eol
docs/evidence/m7-a2b/studio-audit.txt -text whitespace=cr-at-eol
docs/evidence/m7-a2c/studio-audit.txt -text whitespace=cr-at-eol
docs/evidence/m7-ui18/** -text whitespace=cr-at-eol
docs/evidence/m7-18a/** -text whitespace=cr-at-eol
docs/evidence/m7-19a/** -text whitespace=cr-at-eol
docs/evidence/m7-19b/** -text whitespace=cr-at-eol
# A verbatim git patch includes a context-space before the source indentation.
docs/evidence/m7-18a/recorded-to-final.diff whitespace=cr-at-eol,-space-before-tab
# Preserve the author's bundled license verbatim, including its trailing spaces.
assets/environment/megakit/License_Standard.txt whitespace=cr-at-eol,-blank-at-eol
