--!nonstrict
local Test=require("../../tests/Test")
local Config=require("../../build/alchemy/Config")
local Factory=require("../../build/alchemy/Factory")
local Guide=require("../../build/alchemy/FirstSessionView")
local CollisionPlan=require("./CollisionPlan")
local LOD=require("./StableLOD")
local Occlusion=require("./StableOcclusion")
local engine=Factory.new(Config)
Test.test("Studio P0: mandatory starter is omitted without minting familiar or rewards",function()
 Test.truthy(Config.stabilitySkipStarterQA)
 local p=engine.newProfile(8101,1000)
 Test.falsy(p.starter.claimed)
 Test.equal(next(p.pets),nil)
 Test.truthy(engine.claimStarterBudget(p))
 local gold=p.gold
 Test.truthy(engine.deferStarter(p))
 Test.truthy(p.starter.claimed)
 Test.equal(p.starter.choice,nil)
 Test.equal(next(p.pets),nil)
 Test.equal(p.gold,gold)
 Test.truthy(p.tutorial.familiar and p.tutorial.workers)
 Test.falsy(Guide.intro(p))
 Test.equal(Guide.step(p,Config),"essence")
 Test.truthy(engine.validate(p))
 Test.truthy(engine.deferStarter(p))
 Test.equal(p.gold,gold)
 local allowed=engine.act(p,"chooseStarter",{speciesId="slime"},1000)
 Test.falsy(allowed)
 Test.equal(next(p.pets),nil)
 local result=engine.advance(p,1012,false)
 Test.truthy(result.ok)
 Test.equal(result.essenceEarned,12)
 Test.equal(Guide.step(p,Config),"garden")
 Test.truthy(engine.validate(p))
end)
Test.test("Studio P0: first garden loop works with no starter familiar",function()
 local p=engine.newProfile(8102,2000)
 Test.truthy(engine.claimStarterBudget(p));Test.truthy(engine.deferStarter(p))
 Test.truthy(engine.act(p,"buyStarterStation",{stationId="garden"},2000))
 Test.truthy(engine.act(p,"buyCropSeed",{cropId="mandrake",amount=1},2000))
 Test.truthy(engine.act(p,"plantCrop",{bedId=Config.gardenV1.beds[1],cropId="mandrake"},2000))
 Test.truthy(engine.act(p,"waterCrop",{bedId=Config.gardenV1.beds[1]},2000))
 Test.truthy(engine.advance(p,2090,false).ok)
 Test.truthy(engine.act(p,"harvestCrop",{bedId=Config.gardenV1.beds[1]},2090))
 Test.truthy(engine.advance(p,2092,false).ok)
 Test.equal(p.inventory.mandrake,2)
 Test.equal(next(p.pets),nil)
 Test.truthy(engine.validate(p))
end)
Test.test("Studio P0: existing companion is never deleted by deferral",function()
 local p=engine.newProfile(8103,3000)
 Test.truthy(engine.act(p,"chooseStarter",{speciesId="slime"},3000))
 local id="8103:starter_slime"
 Test.truthy(p.pets[id])
 Test.truthy(engine.deferStarter(p))
 Test.truthy(p.pets[id])
 Test.equal(p.starter.choice,"slime")
 Test.truthy(engine.validate(p))
end)
Test.test("Studio P0: historical profiles retain original worker rules",function()
 local p=engine.newProfile(8104,4000)
 engine.grantHistoricalStarters(p)
 Test.falsy(engine.deferStarter(p))
 Test.truthy(p.starter.legacyGrant)
 Test.truthy(p.pets["8104:starter_farmer"])
 Test.truthy(engine.validate(p))
end)
Test.test("Studio P0: tree and boulder collision plan deterministic, no leaf proxies",function()
 local descriptors={trees={
  {id="near",x=12,z=9,radius=7,scale=.7},
  {id="far",x=-24,z=43,radius=12,scale=.9},
 },stones={
  {"Rock_Medium_1",8,15,.55},
  {"Flower_3_Group",8,20,.7},
 }}
 local entries=CollisionPlan.build(descriptors)
 Test.equal(#entries,3)
 Test.equal(entries[1].id,"TreeTrunk_near")
 Test.equal(entries[2].id,"TreeTrunk_far")
 Test.equal(entries[3].kind,"rock")
 for _,d in ipairs(entries)do
  Test.truthy(d.width>0 and d.height>0)
 end
end)
Test.test("Studio P0: static LOD always keeps trees and bounds occlusion cannot hide them",function()
 local entries={{id="near",distance=1,high=true},{id="far",distance=60,high=false}}
 for _,quality in ipairs({"full","reduced","minimal"})do
  Test.equal(next(LOD.select(entries,quality)),nil)
  Test.equal(LOD.budgets[quality].count,0)
  Test.equal(LOD.detailAlpha(1,quality,300),0)
 end
 Test.equal(Occlusion.target(nil,nil),0)
end)
Test.finish()
