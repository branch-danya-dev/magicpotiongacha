--!nonstrict
-- V1-02 tests execute the exact generated Studio-memory Factory, not production V8.
local T=require("../../tests/Test")
local Config=require("../../build/alchemy/Config")
local Factory=require("../../build/alchemy/Factory")
local Garden=require("./GardenV1")
local engine=Factory.new(Config)
local firstBed=Config.gardenV1.beds[1]
local secondBed=Config.gardenV1.beds[2]
local function fresh(uid,now,species)
 local p=engine.newProfile(uid,now)
 T.truthy(engine.claimStarterBudget(p))
 T.truthy(engine.act(p,"chooseStarter",{speciesId=species or "slime"},now))
 T.truthy(engine.act(p,"buyStarterStation",{stationId="garden"},now))
 T.truthy(engine.validate(p))
 return p
end
local function act(p,name,payload,now)
 local ok,reason=engine.act(p,name,payload,now)
 if not ok then error(name.." rejected: "..tostring(reason)) end
 T.truthy(engine.validate(p))
end
T.test("V1-02: crop registry supports species and independent times",function()
 T.equal(Config.schemaVersion,8)
 T.truthy(Config.gardenV1QA)
 T.equal(Config.gardenV1.crops.mandrake.growthSeconds,90)
 T.equal(Config.gardenV1.crops.antarctic_biter.growthSeconds,250)
 T.equal(#Config.gardenV1.crops.antarctic_biter.wateringAt,2)
 T.equal(Config.gardenV1.beds[1],Config.firstSession.bedId)
end)
T.test("V1-02: mandrake requires water and harvest duration, no duplicate crop",function()
 local p=fresh(6201,1000)
 act(p,"buyCropSeed",{cropId="mandrake",amount=1},1000)
 act(p,"plantCrop",{bedId=firstBed,cropId="mandrake"},1000)
 local a=engine.advance(p,1040,false)
 T.truthy(a.ok);T.equal(p.gardenV1.plots[firstBed].progress,0)
 local ok=engine.act(p,"harvestCrop",{bedId=firstBed},1040)
 T.falsy(ok)
 act(p,"waterCrop",{bedId=firstBed},1040)
 ok=engine.act(p,"waterCrop",{bedId=firstBed},1040)
 T.falsy(ok)
 T.truthy(engine.advance(p,1129,false).ok)
 T.equal(p.gardenV1.plots[firstBed].progress,89)
 T.truthy(engine.advance(p,1130,false).ok)
 T.equal(p.gardenV1.plots[firstBed].progress,90)
 act(p,"harvestCrop",{bedId=firstBed},1130)
 T.truthy(engine.advance(p,1131,false).ok)
 T.equal(p.inventory.mandrake or 0,0)
 local result=engine.advance(p,1132,false)
 T.truthy(result.ok);T.equal(result.produced.mandrake,2)
 T.equal(p.inventory.mandrake,2)
 T.equal(p.gardenV1.plots[firstBed],nil)
 T.truthy(p.tutorial.crop);T.truthy(p.tutorial.ingredients)
 local again=engine.advance(p,1180,true)
 T.truthy(again.ok);T.equal(again.produced.mandrake or 0,0)
 T.equal(p.inventory.mandrake,2)
 T.truthy(engine.validate(p))
end)
T.test("V1-02: arctic biter waits at midpoint until second watering",function()
 local p=fresh(6202,2000)
 act(p,"buyCropSeed",{cropId="antarctic_biter",amount=1},2000)
 act(p,"plantCrop",{bedId=firstBed,cropId="antarctic_biter"},2000)
 act(p,"waterCrop",{bedId=firstBed},2000)
 T.truthy(engine.advance(p,2160,false).ok)
 local plant=p.gardenV1.plots[firstBed]
 T.equal(plant.progress,125)
 T.equal(plant.wateredCount,1)
 T.truthy(engine.advance(p,2200,true).ok)
 T.equal(plant.progress,125)
 act(p,"waterCrop",{bedId=firstBed},2200)
 T.truthy(engine.advance(p,2325,false).ok)
 T.equal(plant.progress,250)
 act(p,"harvestCrop",{bedId=firstBed},2325)
 T.truthy(engine.advance(p,2329,false).ok)
 T.equal(p.inventory.antarctic_biter or 0,0)
 local result=engine.advance(p,2330,false)
 T.truthy(result.ok);T.equal(result.produced.antarctic_biter,3)
 T.equal(p.inventory.antarctic_biter,3)
 T.truthy(engine.validate(p))
end)
T.test("V1-02: second garden bed is independently purchased and planted",function()
 local p=fresh(6203,3000)
 local gold=p.gold
 local bad=engine.act(p,"buyGardenBed",{bedId=Config.gardenV1.beds[3]},3000)
 T.falsy(bad);T.equal(p.gold,gold)
 act(p,"buyGardenBed",{bedId=secondBed},3000)
 T.equal(p.gardenV1.ownedBeds,2)
 T.equal(p.gold,gold-Config.gardenV1.bedPrices[2])
 act(p,"buyCropSeed",{cropId="mandrake",amount=1},3000)
 act(p,"buyCropSeed",{cropId="antarctic_biter",amount=1},3000)
 act(p,"plantCrop",{bedId=firstBed,cropId="mandrake"},3000)
 act(p,"plantCrop",{bedId=secondBed,cropId="antarctic_biter"},3000)
 act(p,"waterCrop",{bedId=firstBed},3000)
 T.truthy(engine.advance(p,3090,false).ok)
 T.equal(p.gardenV1.plots[firstBed].progress,90)
 T.equal(p.gardenV1.plots[secondBed].progress,0)
 T.truthy(engine.validate(p))
end)
T.test("V1-02: sprinkler waters all crops but does not plant or harvest",function()
 local p=fresh(6204,4000)
 act(p,"buyCropSeed",{cropId="antarctic_biter",amount=1},4000)
 act(p,"plantCrop",{bedId=firstBed,cropId="antarctic_biter"},4000)
 local before=p.gold
 act(p,"buySprinkler",{},4000)
 T.equal(p.gold,before-Config.gardenV1.sprinklerCost)
 act(p,"buySprinkler",{},4000)
 T.equal(p.gold,before-Config.gardenV1.sprinklerCost)
 local a=engine.advance(p,4250,true)
 T.truthy(a.ok)
 T.equal(p.gardenV1.plots[firstBed].progress,250)
 T.equal(p.gardenV1.plots[firstBed].wateredCount,2)
 T.equal(p.inventory.antarctic_biter or 0,0)
 T.truthy(engine.validate(p))
end)
T.test("V1-02: existing in-progress single V8 bed is converted exactly once",function()
 local p=fresh(6205,5000)
 p.plants[firstBed]={seedId="mandrake",plantedAt=5000,duration=8,progress=4}
 T.truthy(engine.validate(p))
 T.truthy(engine.advance(p,5001,false).ok)
 T.equal(p.plants[firstBed],nil)
 T.equal(p.gardenV1.plots[firstBed].progress,46)
 T.equal(p.gardenV1.plots[firstBed].wateredCount,1)
 T.equal(p.inventory.mandrake or 0,0)
 T.truthy(engine.advance(p,5001,true).ok)
 T.equal(p.gardenV1.plots[firstBed].progress,46)
 T.truthy(engine.validate(p))
end)
T.test("V1-02: multi-crop growth has online/offline parity and immutable legacy mode",function()
 local a=fresh(6206,6000)
 act(a,"buyCropSeed",{cropId="mandrake",amount=1},6000)
 act(a,"plantCrop",{bedId=firstBed,cropId="mandrake"},6000)
 act(a,"waterCrop",{bedId=firstBed},6000)
 local b=fresh(6207,6000)
 act(b,"buyCropSeed",{cropId="mandrake",amount=1},6000)
 act(b,"plantCrop",{bedId=firstBed,cropId="mandrake"},6000)
 act(b,"waterCrop",{bedId=firstBed},6000)
 T.truthy(engine.advance(a,6090,false).ok)
 T.truthy(engine.advance(b,6090,true).ok)
 T.equal(a.gardenV1.plots[firstBed].progress,b.gardenV1.plots[firstBed].progress)
 T.truthy(engine.validate(a));T.truthy(engine.validate(b))
 local historical=engine.newProfile(6208,7000)
 engine.grantHistoricalStarters(historical)
 T.falsy(Garden.active(Config,historical))
 T.truthy(engine.advance(historical,7100,true).ok)
 T.equal(historical.gardenV1,nil)
 T.truthy(engine.validate(historical))
end)
T.finish()
