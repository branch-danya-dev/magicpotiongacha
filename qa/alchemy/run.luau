--!nonstrict
-- Runs AFTER the generated QA game sources are built; tests the actual patched Factory.
local T=require("../../tests/Test")
local Config=require("../../build/alchemy/Config")
local Factory=require("../../build/alchemy/Factory")
local View=require("../../build/alchemy/FirstSessionView")
local Policy=require("./Policy")
local engine=Factory.new(Config)
T.test("Alchemy First: current V8 schema and inherited progression remain",function()
 T.equal(Config.schemaVersion,8)
 T.equal(Config.economyV2.crystal.passiveEssence[1],1)
 T.equal(Config.economyV2.crystal.passiveEssence[2],2)
 T.equal(Config.firstSession.bedCost,200)
 T.equal(Config.firstSession.cauldronCost,300)
 T.truthy(Config.alchemyFirstQA)
end)
T.test("Alchemy First: Essence accrues with no clicks and no familiar assigned",function()
 local p=engine.newProfile(4101,1000)
 T.truthy(engine.claimStarterBudget(p))
 T.truthy(engine.act(p,"chooseStarter",{speciesId="slime"},1000))
 T.equal(View.step(p,Config),"essence")
 T.equal(#View.actions(p,Config),0)
 T.truthy(View.line(p,Config):find("автоматически",1,true))
 local result=engine.advance(p,1015,false)
 T.truthy(result.ok);T.equal(result.essenceEarned,15)
 T.equal(p.essence,15);T.truthy(p.tutorial.essence);T.truthy(p.tutorial.crystal)
 T.equal(View.step(p,Config),"garden")
 T.truthy(engine.validate(p))
end)
T.test("Alchemy First: manual and repeated click intents cannot mint Essence",function()
 local p=engine.newProfile(4102,2000)
 T.truthy(engine.act(p,"chooseStarter",{speciesId="farmer"},2000))
 local ok,why=engine.act(p,"click",{},2000)
 T.falsy(ok);T.equal(why,"Essence accumulates automatically");T.equal(p.essence,0)
 engine.advance(p,2001,false)
 local before=p.essence
 ok=engine.act(p,"click",{},2001)
 T.falsy(ok);T.equal(p.essence,before)
 T.equal(engine.advance(p,2001,false).essenceEarned,0)
end)
T.test("Alchemy First: offline and online production use same deterministic accrual",function()
 local online=engine.newProfile(4103,3000)
 local offline=engine.newProfile(4103,3000)
 T.truthy(engine.act(online,"chooseStarter",{speciesId="brewer"},3000))
 T.truthy(engine.act(offline,"chooseStarter",{speciesId="brewer"},3000))
 local a=engine.advance(online,3090,false)
 local b=engine.advance(offline,3090,true)
 T.truthy(a.ok);T.truthy(b.ok)
 T.equal(a.essenceEarned,90);T.equal(b.essenceEarned,90)
 T.equal(online.essence,offline.essence)
 T.truthy(engine.validate(online));T.truthy(engine.validate(offline))
end)
T.test("Alchemy First: historical profile retains manual click and zero base passive",function()
 local p=engine.newProfile(4104,4000)
 engine.grantHistoricalStarters(p)
 T.falsy(Policy.active(Config,p))
 T.equal(engine.advance(p,4005,true).essenceEarned,0)
 local yes=engine.act(p,"click",{},4005)
 T.truthy(yes);T.equal(p.essence,Config.manualClickEssence)
 T.truthy(engine.validate(p))
end)
T.test("Alchemy First: tutorial flags are never fabricated before selecting starter",function()
 local p=engine.newProfile(4105,5000)
 local result=engine.advance(p,5010,true)
 T.equal(result.essenceEarned,10)
 T.falsy(p.tutorial.essence)
 T.truthy(engine.act(p,"chooseStarter",{speciesId="slime"},5010))
 T.equal(View.step(p,Config),"essence")
 engine.advance(p,5011,false)
 T.truthy(p.tutorial.essence)
end)
T.finish()
