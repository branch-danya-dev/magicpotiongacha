--!nonstrict
local T=require("./Test")
local L=require("../qa/romantic-island/Layout")
local Config=require("../src/shared/Config")
local Island=require("../src/shared/PersonalIsland")
local Geometry=require("../src/shared/NatureGeometry")
local function check(tree,needle)
	local a=L.audit(Config,Island,Geometry,{tree})
	T.falsy(a.ok);T.truthy(string.find(table.concat(a.errors,";"),needle,1,true)~=nil)
end
T.test("R3 layout reserves the full building rectangle and all existing work endpoints",function()
	local a=L.audit(Config,Island,Geometry)
	T.truthy(a.ok,table.concat(a.errors,";"));T.equal(a.stations,13);T.equal(a.waypoints,26)
	T.truthy(a.minStationClearance>=8)
end)
T.test("R3 rejects the reported R2 tree overlapping cauldron2",function()
	check({name="CommonTree_3",x=20,z=12,scale=1.15,yaw=-35},"station cauldron2")
end)
T.test("R3 future construction clearance checks trunk extents, not only origin",function()
	check({name="CommonTree_1",x=-41,z=-41,scale=.56,yaw=0},"construction overlap")
end)
T.test("R3 rejects a tree crossing the six-stud spawn-to-book corridor",function()
	check({name="CommonTree_5",x=2,z=10,scale=1,yaw=0},"main path")
end)
T.test("R3 rejects off-island scenery roots instead of expanding the walkable island",function()
	check({name="CommonTree_3",x=68,z=0,scale=1,yaw=0},"outside walkable ellipse")
end)
return true
