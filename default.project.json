{
  "name": "PotionTycoon",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "PotionTycoon": { "$className": "Folder", "Shared": { "$path": "src/shared" } }
    },
    "ServerScriptService": { "PotionTycoon": { "$path": "src/server" } },
    "ServerStorage": {
      "M7NatureTemplates": {"$path": "assets/environment/woodland/M7NatureTemplates.rbxmx"},
      "SpellbookLectern": {"$path": "assets/props/SpellbookLectern.rbxmx"}
    },
    "StarterPlayer": {
      "$properties": { "DevCameraOcclusionMode": "Zoom" },
      "StarterPlayerScripts": { "PotionTycoon": { "$path": "src/client" } }
    },
    "StarterGui": { "$properties": { "ScreenOrientation": "Sensor" } },
    "Workspace": {
      "$properties": { "Gravity": 196.2, "StreamingEnabled": false },
      "$attributes": { "UIFoundationDemo": true }
    },
    "Lighting": { "$properties": { "ClockTime": 18, "Brightness": 2 } }
  }
}
